# ─── Mente em Paz · Apache/LiteSpeed (Hostinger) ───────────────────────
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# HTTPS obrigatório
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Rotas sem barra final → com barra (ex.: /mente-em-paz → /mente-em-paz/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ %{REQUEST_URI}/ [L,R=301]
</IfModule>

# Tipos de mídia
AddType image/webp .webp
AddType image/svg+xml .svg
AddType video/webm .webm
AddType video/mp4 .mp4
AddType audio/mpeg .mp3
AddType audio/mp4 .m4a
AddType text/vtt .vtt
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/vtt application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Cache: arquivos com hash (assets/) por 1 ano; HTML sempre revalidado
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg|webp|png|jpg|jpeg|webm|mp4|mp3|m4a)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(favicon\.svg|favicon-32\.png|apple-touch-icon\.png|og-image\.jpg|icon-.*\.png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
